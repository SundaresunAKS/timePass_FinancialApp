        <item name="colorAccentGradientEnd">@color/accent_cyan_light</item>
        <item name="colorAccentDark">@color/accent_cyan_dark</item>
        <item name="android:statusBarColor">@color/accent_cyan_dark</item>
    </style>

    <style name="Theme.FinancialApp.Brown" parent="Base.Theme.FinancialApp">
        <item name="colorPrimary">@color/accent_brown</item>
        <item name="colorAccentGradientEnd">@color/accent_brown_light</item>
        <item name="colorAccentDark">@color/accent_brown_dark</item>
        <item name="android:statusBarColor">@color/accent_brown_dark</item>
    </style>

    <style name="Theme.FinancialApp.Slate" parent="Base.Theme.FinancialApp">
        <item name="colorPrimary">@color/accent_slate</item>
        <item name="colorAccentGradientEnd">@color/accent_slate_light</item>
        <item name="colorAccentDark">@color/accent_slate_dark</item>
        <item name="android:statusBarColor">@color/accent_slate_dark</item>
    </style>

    <!--
      NavigationUI replaces the toolbar's navigation icon with its own DrawerArrowDrawable,
      which takes its colour from colorControlNormal and ignores app:navigationIconTint.
      In light mode that resolves to a dark grey, leaving the hamburger and the Up arrow
      almost invisible on the coloured toolbar. Pinning colorControlNormal for the toolbar
      only is what actually reaches that drawable.
    -->
    <style name="ThemeOverlay.FinancialApp.Toolbar" parent="">
        <item name="colorControlNormal">?attr/colorOnPrimary</item>
        <item name="colorControlHighlight">?attr/colorOnPrimary</item>
    </style>

    <style name="Widget.FinancialApp.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="subtitleTextColor">?attr/colorOnPrimary</item>
        <item name="navigationIconTint">?attr/colorOnPrimary</item>
    </style>

    <style name="Widget.FinancialApp.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.FinancialApp.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipCornerRadius">16dp</item>
    </style>

    <style name="Widget.FinancialApp.Tag" parent="android:Widget.TextView">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingStart">@dimen/spacing_sm</item>
        <item name="android:paddingEnd">@dimen/spacing_sm</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.FinancialApp.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:paddingStart">@dimen/spacing_xs</item>
        <item name="android:paddingBottom">@dimen/spacing_sm</item>
    </style>

    <style name="Widget.FinancialApp.SettingsDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">56dp</item>
        <item name="android:background">@color/surface_variant</item>
    </style>
</resources>
