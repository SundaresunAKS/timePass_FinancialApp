<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      DayNight base: the light values live in values/colors.xml and the dark ones in
      values-night/colors.xml, so every layout referencing @color/surface and friends
      follows the system or user theme with no per-layout work.

      The accent is a theme attribute rather than a colour resource, because it must be
      switchable at runtime; see Theme.FinancialApp.* below.
    -->
    <style name="Base.Theme.FinancialApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnError">@color/on_error</item>

        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Accent variants. Each sets the trio the UI paints with. -->
    <style name="Theme.FinancialApp" parent="Base.Theme.FinancialApp">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorAccentGradientEnd">@color/accent_green_light</item>
        <item name="colorAccentDark">@color/accent_green_dark</item>
        <item name="android:statusBarColor">@color/accent_green_dark</item>
    </style>

    <style name="Theme.FinancialApp.Blue" parent="Base.Theme.FinancialApp">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorAccentGradientEnd">@color/accent_blue_light</item>
        <item name="colorAccentDark">@color/accent_blue_dark</item>
        <item name="android:statusBarColor">@color/accent_blue_dark</item>
    </style>

    <style name="Theme.FinancialApp.Indigo" parent="Base.Theme.FinancialApp">
        <item name="colorPrimary">@color/accent_indigo</item>
        <item name="colorAccentGradientEnd">@color/accent_indigo_light</item>
        <item name="colorAccentDark">@color/accent_indigo_dark</item>
        <item name="android:statusBarColor">@color/accent_indigo_dark</item>
    </style>

    <style name="Theme.FinancialApp.Teal" parent="Base.Theme.FinancialApp">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorAccentGradientEnd">@color/accent_teal_light</item>
        <item name="colorAccentDark">@color/accent_teal_dark</item>
        <item name="android:statusBarColor">@color/accent_teal_dark</item>
    </style>

    <style name="Theme.FinancialApp.Purple" parent="Base.Theme.FinancialApp">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorAccentGradientEnd">@color/accent_purple_light</item>
        <item name="colorAccentDark">@color/accent_purple_dark</item>
        <item name="android:statusBarColor">@color/accent_purple_dark</item>
    </style>

    <style name="Theme.FinancialApp.Rose" parent="Base.Theme.FinancialApp">
        <item name="colorPrimary">@color/accent_rose</item>
        <item name="colorAccentGradientEnd">@color/accent_rose_light</item>
        <item name="colorAccentDark">@color/accent_rose_dark</item>
        <item name="android:statusBarColor">@color/accent_rose_dark</item>
