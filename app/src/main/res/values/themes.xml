    <style name="Theme.FinancialApp.Crimson" parent="Base.Theme.FinancialApp">
        <item name="colorPrimary">@color/accent_crimson</item>
        <item name="colorAccentGradientEnd">@color/accent_crimson_light</item>
        <item name="colorAccentDark">@color/accent_crimson_dark</item>
        <item name="android:statusBarColor">@color/accent_crimson_dark</item>
    </style>

    <style name="Theme.FinancialApp.Amber" parent="Base.Theme.FinancialApp">
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorAccentGradientEnd">@color/accent_amber_light</item>
        <item name="colorAccentDark">@color/accent_amber_dark</item>
        <item name="android:statusBarColor">@color/accent_amber_dark</item>
    </style>

    <style name="Theme.FinancialApp.Olive" parent="Base.Theme.FinancialApp">
        <item name="colorPrimary">@color/accent_olive</item>
